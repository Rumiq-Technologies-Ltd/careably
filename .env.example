# Copy to .env.local and fill in. .env.local is git-ignored and must stay that way.
# Never put a real key in this file: it is a template meant to be shared.

# Public site origin, used for metadataBase, canonical URLs and the sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://careably.care

# Resend API key. Server only, never prefixed NEXT_PUBLIC_.
RESEND_API_KEY=

# Where partner inquiries are delivered.
INQUIRY_TO_EMAIL=hello@careably.care

# Sender. Accepts a bare address or the "Name <address>" form.
# The domain must be verified in Resend before this will send.
INQUIRY_FROM_EMAIL=Careably <inquiries@careably.care>
